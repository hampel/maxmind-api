# Copy this file to .env beside the package. The rig loads it - unless an agent is running the
# command, in which case it deliberately does not; see harness/lib/harness.php.

# A SANDBOX account's id and licence key. The sandbox is a separate MaxMind account; it answers
# the GeoIP web services for free, with fixed data for MaxMind's test addresses only. The geoip
# exercise uses these unless MAXMIND_GEOIP_LIVE=1.
MAXMIND_SANDBOX_ACCOUNT_ID=
MAXMIND_SANDBOX_LICENSE_KEY=

# A LIVE account's id and licence key. downloads always uses these, since the sandbox has no
# download service; geoip uses them only with MAXMIND_GEOIP_LIVE=1, and each lookup then spends a
# paid query.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional. Set to exactly 1 to point geoip at the live account - five or six paid queries, one of
# them Insights. Anything else is the sandbox.
MAXMIND_GEOIP_LIVE=

# Optional. Set to exactly 1 to let downloads fetch a checksum and a database, each counting
# against the account's daily download limit - 1,000, or 30 for a GeoLite account. Anything else
# makes only the HEAD request, which is free.
MAXMIND_DOWNLOAD=

# Optional. The edition downloads asks about; default GeoLite2-Country, the smallest. Where to keep
# the database it extracts; default a temporary file, removed afterwards.
MAXMIND_EDITION=
MAXMIND_DOWNLOAD_PATH=

# Optional. The address geoip looks up through the package; default a sandbox test address.
MAXMIND_ADDRESS=

# Optional. The file database reads, and a comma-separated list of addresses to look up in it;
# default the City test database in tests/fixtures and MaxMind's test addresses.
MAXMIND_DATABASE=
MAXMIND_ADDRESSES=

# Two more variables the harness reads are deliberately not listed above, because this file is
# meant to be copied to .env and they must never live in one:
#
#   MAXMIND_AGENT_MAY_QUERY_LIVE=1     geoip may spend live queries, in an agent session
#   MAXMIND_AGENT_MAY_DOWNLOAD=1       downloads may spend downloads, in an agent session
#
# MAXMIND_GEOIP_LIVE and MAXMIND_DOWNLOAD are otherwise ignored when CLAUDECODE is set - they are
# read from a file written by whoever owns the account, and an agent would inherit an
# authorisation nobody gave it. Put the override on the command line for one run.
